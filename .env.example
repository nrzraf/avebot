# AveBot environment variables
# Copy this file to .env for local development. Never commit .env.
# On Railway, add these as project variables instead.

NODE_ENV=production
PORT=3000

# Discord (selfbot user token). Keep this secret. Never expose it in the web UI.
DISCORD_TOKEN=

# Spotify (optional). Used to resolve Spotify track/playlist URLs.
# If the Web API is unavailable, AveBot falls back to public metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Path to the yt-dlp binary. Leave empty to auto-detect (yt-dlp on PATH, then python -m yt_dlp).
YTDLP_PATH=

# YouTube player client used by yt-dlp. The default works around the current
# "The page needs to be reloaded" error. Change only if you know what you are doing.
YTDLP_PLAYER_CLIENT=default,web_embedded

# JavaScript runtime used by yt-dlp to solve YouTube signature/n challenges.
# Without it YouTube answers 403 ("unable to download video data"). Set to "off" to disable.
YTDLP_JS_RUNTIME=node

# Remote EJS challenge solver component fetched by yt-dlp (recommended).
# Set to "off" to disable, or to another component spec if you know what you are doing.
YTDLP_REMOTE_COMPONENTS=ejs:github

# YouTube cookie. STRONGLY recommended: YouTube blocks datacenter IPs (Railway) and
# answers "Sign in to confirm you are not a bot". AveBot uses this cookie FIRST and
# only falls back to an anonymous request when it is missing or fails.
# Accepts EITHER a browser-extension JSON export (array of {name,value})
# OR a raw "name=value; name=value" header string.
YOUTUBE_COOKIE=
